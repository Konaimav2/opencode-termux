+        return false;
+    }
     return switch (builtin.os.tag) {
         .linux => switch (pthread_tryjoin_np(thread.getHandle(), null)) {
             0 => true,
diff --git a/packages/native/src/miniaudio_shim.c b/packages/native/src/miniaudio_shim.c
