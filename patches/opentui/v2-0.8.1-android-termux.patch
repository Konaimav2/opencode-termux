--- a/packages/native/src/clipboard/host.zig
+++ b/packages/native/src/clipboard/host.zig
@@ -102,6 +102,10 @@ extern "c" fn pthread_tryjoin_np(thread: std.Thread.Handle, result: ?*?*anyopaqu
 extern "c" fn pthread_peekjoin_np(thread: std.Thread.Handle, result: ?*?*anyopaque) c_int;
 
 fn tryJoinThread(thread: std.Thread) bool {
