# opencode-termux: OpenTUI v0.8.1 Android/Termux patch
#
# Applies to anomalyco/opentui tag v0.8.1:
#   git -C <opentui-v0.8.1> apply patches/opentui/v2-0.8.1-android-termux.patch
#
# - build.zig: bionic sysroot options, translated-header shims, skip
#   pthread/m on Android (bionic libc contains both).
# - clipboard/host.zig: bionic lacks pthread_tryjoin_np/peekjoin_np.
# - miniaudio_shim.c: no ALSA/PulseAudio headers on Android; use AAudio.
#
diff --git a/packages/native/build.zig b/packages/native/build.zig
index eebdf8b..d55f151 100644
--- a/packages/native/build.zig
+++ b/packages/native/build.zig
@@ -452,8 +452,11 @@ fn addNativeAudioDependencies(
         .macos => addMacOSSystemLibraries(b, module, macos_sdk_path.?),
         .linux => {
             module.linkSystemLibrary("dl", .{});
-            module.linkSystemLibrary("pthread", .{});
-            module.linkSystemLibrary("m", .{});
+            if (!target.result.abi.isAndroid()) {
+                // bionic libc already contains pthread/m
+                module.linkSystemLibrary("pthread", .{});
+                module.linkSystemLibrary("m", .{});
+            }
         },
         else => {},
     }
@@ -490,26 +493,45 @@ fn ghosttyVtAvailable(target: std.Build.ResolvedTarget) bool {
     };
 }
 
+/// Merged bionic sysroot dir staged by scripts/build-opentui-v2.sh.
+fn bionicSysrootInclude(b: *std.Build) ?[]const u8 {
+    return b.option([]const u8, "bionic-sysroot-inc", "Merged bionic sysroot include directory (Android)");
+}
+
+/// Bionic sysroot library dir for the Android target.
+fn bionicSysrootLib(b: *std.Build) ?[]const u8 {
+    return b.option([]const u8, "bionic-sysroot-lib", "Bionic sysroot library directory (Android)");
+}
+
 fn addTranslatedCImports(
     b: *std.Build,
     module: *std.Build.Module,
     optimize: std.lang.Optimize,
     target: std.Build.ResolvedTarget,
 ) void {
+    const bionic_inc = bionicSysrootInclude(b);
     const miniaudio_translate = b.addTranslateC(.{
-        .root_source_file = b.path("src/vendor/miniaudio/miniaudio.h"),
+        .root_source_file = if (bionic_inc != null)
+            .{ .cwd_relative = b.fmt("{s}/__opentui/miniaudio_shimmed.h", .{bionic_inc.?}) }
+        else
+            b.path("src/vendor/miniaudio/miniaudio.h"),
         .target = target,
         .optimize = optimize,
     });
+    if (bionic_inc) |inc| miniaudio_translate.addIncludePath(.{ .cwd_relative = inc });
     miniaudio_translate.addIncludePath(b.path("src"));
     module.addImport("miniaudio", miniaudio_translate.createModule());
 
     const yoga_dep = b.dependency("yoga", .{});
     const yoga_translate = b.addTranslateC(.{
-        .root_source_file = b.path("src/yoga-bridge.h"),
+        .root_source_file = if (bionic_inc != null)
+            .{ .cwd_relative = b.fmt("{s}/__opentui/yoga_bridge_shimmed.h", .{bionic_inc.?}) }
+        else
+            b.path("src/yoga-bridge.h"),
         .target = target,
         .optimize = optimize,
     });
+    if (bionic_inc) |inc| yoga_translate.addIncludePath(.{ .cwd_relative = inc });
     yoga_translate.addIncludePath(yoga_dep.path(""));
     module.addImport("yoga", yoga_translate.createModule());
     addContextABIHeader(b, module, optimize, target);
@@ -545,6 +567,8 @@ fn applyDependencies(
     build_options: *std.Build.Step.Options,
 ) void {
     module.addOptions("build_options", build_options);
+    if (bionicSysrootInclude(b)) |inc| module.addSystemIncludePath(.{ .cwd_relative = inc });
+    if (bionicSysrootLib(b)) |lib| module.addLibraryPath(.{ .cwd_relative = lib });
     addTranslatedCImports(b, module, optimize, target);
 
     const ghostty_vt_available = ghosttyVtAvailable(target);
