+  const termuxRelease = Effect.fnUntraced(function* () {
+    // Android/Termux fork channel: opencode.ai knows nothing about it, so
+    // resolve our own GitHub releases instead. The install step still
+    // reports "Installation method not found" on device (dpkg installs are
+    // handled outside the binary); the check/notify path is what matters.
+    // NOTE: our v2 releases are prereleases, which `releases/latest`
+    // skips — scan the list for the newest v2 tag with a .deb asset.
+    const response = yield* Effect.tryPromise({
+      try: (signal) =>
+        fetch("https://api.github.com/repos/Konaimav2/opencode-termux/releases?per_page=10", {
+          signal: AbortSignal.any([signal, AbortSignal.timeout(10_000)]),
+        }),
+      catch: (cause) =>
+        new UpgradeError(
+          {
+            title: "Could not check for OpenCode updates",
+            detail: errorDetail(cause),
+            retry: "Check your network, then run opencode upgrade again.",
+          },
+          { cause },
+        ),
+    })
+    if (!response.ok)
+      return yield* Effect.fail(
+        new UpgradeError({
+          title: "Could not check for OpenCode updates",
+          detail: `The update service returned HTTP ${response.status}.`,
+          retry: "Try again in a few minutes.",
+        }),
+      )
+    const list: { tag_name?: string; draft?: boolean; assets?: { browser_download_url?: string }[] }[] =
+      yield* Effect.tryPromise({
+        try: () => response.json(),
+        catch: (cause) =>
+          new UpgradeError(
+            {
+              title: "Could not read the OpenCode update information",
+              detail: errorDetail(cause),
+              retry: "Try again in a few minutes.",
+            },
+            { cause },
+          ),
+      })
+    const releases = (Array.isArray(list) ? list : []).flatMap((item) => {
+      if (item?.draft || !/^v2\./.test(item?.tag_name ?? "")) return []
+      const version = (item?.tag_name ?? "").replace(/^v/, "").replace(/-android.*$/, "")
+      const parsed = parseReleaseVersion(version)
+      if (!parsed || parsed.major !== "2") return []
+      const expected = `opencode_${version}_aarch64.deb`
+      const pkg = (item?.assets ?? [])
+        .map((asset) => asset?.browser_download_url ?? "")
+        .find((url) => url.split("/").pop() === expected)
+      return pkg ? [{ package: pkg, version }] : []
+    })
+    const data = releases[0]
+    if (!data)
+      return yield* Effect.fail(
+        new UpgradeError({
+          title: "Could not read the OpenCode update information",
+          detail: "The update service returned incomplete release information.",
+          retry: "Try again in a few minutes.",
+        }),
+      )
+    return data
+  })
+
