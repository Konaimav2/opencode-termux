#!/data/data/com.termux/files/usr/bin/sh
# opencode2 — wrapper for the OpenCode v2 CLI on Android/Termux.
#
# Derived from the upstream opencode2 wrapper plus our bin/opencode tweaks:
# LD_PRELOAD libtagfix.so (disables Android bionic TBI heap tagging — without
# it Bun/JSC NaN-boxing clears the top-byte tag on heap pointers and bionic
# SIGABRTs on free(): "Pointer tag ... was truncated"), BUN_SELF_EXE (so the
# standalone loader finds its module graph under libtermux-exec), a TMPDIR
# default, and the @parcel/watcher filewatcher guard. Installs side by side
# with the v1 "opencode" package: v2 files live under libexec/opencode2/.
#
# Path resolution order (supports both standalone zip and installed package):
#   zip:       opencode2, opencode2.bin, libtagfix.so, libopentui.so in one dir
#   installed: bin/opencode2, libexec/opencode2/{opencode2.bin,libtagfix.so,libopentui.so}

set -eu

SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
DIR="$(CDPATH= cd -- "$(dirname "$SELF")" && pwd)"

# Termux markers, in case we are launched outside a Termux shell.
export PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
export ANDROID_ROOT="${ANDROID_ROOT:-/system}"
export TERMUX_VERSION="${TERMUX_VERSION:-opencode-termux}"

# Bun standalone binaries unpack/temp under TMPDIR; Termux does not always set
# it, so default to the home tmp dir and make sure it exists.
export TMPDIR="${OPENCODE_TMPDIR:-${HOME:-/data/data/com.termux/files/home}/tmp}"
export TEMP="$TMPDIR"
export TMP="$TMPDIR"
mkdir -p "$TMPDIR" 2>/dev/null || true

# Locate the native library directory. Prefer the private installed package
# layout (libexec/opencode2) over the flat zip layout (libs next to the
# wrapper), so upgrades never pick up a stale flat-layout library.
NATIVE_LIB_DIR=""
for candidate in "$DIR/../libexec/opencode2" "$PREFIX/libexec/opencode2" "$DIR"; do
    if [ -f "$candidate/libopentui.so" ]; then
        NATIVE_LIB_DIR="$candidate"
        break
    fi
done

if [ -n "$NATIVE_LIB_DIR" ]; then
    # libtagfix.so: LD_PRELOAD constructor calls mallopt to turn off heap
    # tagging inside the opencode2 process (execv-based wrappers cannot do
    # this because execv resets the tagging level on the new image).
    if [ -f "$NATIVE_LIB_DIR/libtagfix.so" ]; then
        export LD_PRELOAD="$NATIVE_LIB_DIR/libtagfix.so${LD_PRELOAD:+:$LD_PRELOAD}"
    fi
    # Bun's JIT-compiled modules may need shared libs we ship alongside.
    export LD_LIBRARY_PATH="$NATIVE_LIB_DIR${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    # opentui's renderer library is loaded from the real filesystem on
    # Android (Bun's /$bunfs/root/ virtual paths are not intercepted).
    export OPENTUI_LIB_PATH="$NATIVE_LIB_DIR/libopentui.so"
    # @parcel/watcher only bundles a host-arch native binding in this build;
    # disable it on Android/Termux to avoid a dlopen architecture mismatch.
    export OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER="${OPENCODE_EXPERIMENTAL_DISABLE_FILEWATCHER:-true}"
    # If a real Bun binary is shipped next to opencode2, use it for plugin installs.
    if [ -x "$NATIVE_LIB_DIR/bun" ]; then
        export OPENCODE_BUN_PATH="$NATIVE_LIB_DIR/bun"
    fi
else
    echo "opencode2: warning: native library directory not found, may crash on Android 11+" >&2
fi

# Tell Bun's standalone loader exactly which file holds the embedded module
# graph. On Termux, libtermux-exec rewrites this exec to
# `/system/bin/linker64 <opencode2.bin>`, which makes /proc/self/exe point at
# the linker instead of opencode2.bin. BUN_SELF_EXE (checked before
# /proc/self/exe by our Bun patch) overrides that so Bun finds its
# "---- Bun! ----" trailer and runs the embedded OpenCode v2 JS.
#
# Locate opencode2.bin. Prefer the installed package layout first so upgrades
# do not accidentally execute a stale flat-layout binary.
for candidate in \
    "$DIR/../libexec/opencode2/opencode2.bin" \
    "$PREFIX/libexec/opencode2/opencode2.bin" \
    "$DIR/opencode2.bin"
do
    if [ -x "$candidate" ]; then
        export BUN_SELF_EXE="$candidate"
        exec "$candidate" "$@"
    fi
done

echo "opencode2: error: could not find opencode2.bin" >&2
exit 127
